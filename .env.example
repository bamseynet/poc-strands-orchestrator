# Copy to .env. Never put credentials in this file: use your normal AWS credential chain.

# fake: rule-based stand-in, no AWS needed. bedrock: real models.
LLM_MODE=fake

# Only used with LLM_MODE=bedrock. These are geo inference profile ids from the Bedrock model cards.
# Use the eu., au., jp. or global. prefix to match your region and data residency needs.
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5
BEDROCK_WORKER_MODEL_ID=us.anthropic.claude-haiku-5-5
AWS_REGION=us-east-1

# Budgets shared by the orchestrator and all its workers for one run.
RUN_TIMEOUT_S=300
MAX_TOTAL_TURNS=40
MAX_TOTAL_TOKENS=500000

# Pacing of the fake LLM. 0 runs flat out.
FAKE_LLM_DELAY_SCALE=1

# API. Set a token on anything reachable by others: every run spends money.
# API_ACCESS_TOKEN=
MAX_CONCURRENT_RUNS=5

# Tracing. Set a collector endpoint to export spans over OTLP, or print them locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=incident-orchestrator
OTEL_CONSOLE_EXPORT=false
