# The agent, for Bedrock AgentCore Runtime, which requires port 8080 and linux/arm64. The CDK asset
# sets the platform, so this also builds natively for local testing.
FROM public.ecr.aws/docker/library/python:3.12-slim

ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PATH=/app/.venv/bin:$PATH
RUN pip install --no-cache-dir uv==0.13.6

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --extra agentcore

RUN useradd --create-home agent
USER agent
EXPOSE 8080

# ADOT sends the Strands spans to CloudWatch, as the AgentCore observability docs describe.
CMD ["opentelemetry-instrument", "python", "-m", "incident_agent.agentcore_app"]
